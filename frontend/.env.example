# Copy to .env.local and adjust. Never commit real secrets.

# Public URL of this site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the backend REST API. Leave empty to use the built-in mock API.
# API_BASE_URL=https://api.greenfield.example

# Shared secret the backend sends to POST /api/revalidate (min 32 characters).
# REVALIDATE_SECRET=change-me-to-a-long-random-string-0123456789

# Artificial delay (ms) for the mock API, to make loading states visible in development.
MOCK_API_DELAY_MS=300

# Spam protection for forms: submissions per visitor and form in 10 minutes, and the minimum time (ms)
# between page load and submit. The e2e tests relax both (see playwright.config.ts).
# FORM_RATE_LIMIT=5
# FORM_MIN_FILL_MS=2000

# Set to false on staging/preview deployments so search engines don't index them (robots.txt).
# ALLOW_INDEXING=true
